# Applied Innovation Platform MCP Server Configuration

# === Paths ===
# Path to the applied-innovation-platform skills directory
AIP_SKILLS_DIR=../applied-innovation-platform/skills
# Path to the shared engagements directory
AIP_ENGAGEMENTS_DIR=../applied-innovation-platform/engagements

# === LLM Configuration ===
# The router auto-detects which model to use based on which keys are set.
# Priority: AIP_MODEL override > ANTHROPIC > GOOGLE > OPENAI > OLLAMA

# Explicit model override (optional). Examples:
#   claude-sonnet-4-20250514, gemini/gemini-2.0-flash, gpt-4o, ollama/llama3
# AIP_MODEL=

# Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-...

# Google (Gemini)
# GOOGLE_API_KEY=...

# OpenAI (GPT-4)
# OPENAI_API_KEY=sk-...

# Local models via Ollama
# OLLAMA_BASE_URL=http://localhost:11434

# === Server ===
AIP_HOST=127.0.0.1
AIP_PORT=8100
